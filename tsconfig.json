{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["shared", "server", "mcp", "client/src", "test", "scripts"]
}
