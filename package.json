{
  "name": "devart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DevArt: create architecture diagrams by hand, or from Claude Code through MCP",
  "scripts": {
    "dev:server": "node --watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "mcp": "node mcp/stdio.ts",
    "test": "node --test --test-force-exit test/*.test.ts",
    "e2e": "vite build && node test/e2e.ts",
    "open": "node scripts/launcher.ts open",
    "stop": "node scripts/launcher.ts stop",
    "shortcut": "node scripts/launcher.ts install",
    "shortcut:remove": "node scripts/launcher.ts uninstall",
    "icons": "node scripts/make-icons.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.3.0",
    "lib0": "^0.2.119",
    "pdf-lib": "^1.17.1",
    "ws": "^8.22.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0"
  }
}
